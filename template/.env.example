# Copy to .env (gitignored) and set what differs on this machine.
# The Godot 4.7 .NET ("mono") build: a Windows exe driven from WSL works.
#GODOT=/mnt/c/data/tools/Godot_v4.7.2-stable_mono_win64/Godot_v4.7.2-stable_mono_win64_console.exe
# The .NET SDK: a Linux dotnet on PATH, or the Windows one.
#DOTNET=/mnt/c/Program Files/dotnet/dotnet.exe
# forward_plus once the GPU driver copes; mobile is the safe default.
#RENDER_METHOD=mobile
